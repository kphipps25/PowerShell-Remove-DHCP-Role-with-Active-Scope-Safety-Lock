#requires -Modules ActiveDirectory
<#
.SYNOPSIS
    Safely removes the DHCP Server role from servers listed in
    Domain-DHCP-Audit.csv.
.DESCRIPTION
    The script:
      - Reads DHCP removal candidates from CSV
      - Performs a fresh DHCP check against each server
      - Checks DHCP role and DHCPServer service
      - Checks all IPv4 scopes
      - BLOCKS removal if active scopes exist
      - Optionally allows an explicit active-scope override
      - Requires per-server confirmation
      - Removes the DHCP Server role
      - Correctly handles removal requiring a reboot
      - Uses Windows Feature state as authoritative verification
      - Reports lingering DHCPServer service as "Pending Reboot"
      - Optionally removes DHCP authorization from AD
      - Exports removal results
      - Exports DHCP scope information
      - Creates a separate list of servers requiring reboot
.NOTES
    Recommended initial settings:
        $AllowActiveScopeOverride = $false
        $AllowReboot = $false
        $RemoveDHCPAuthorization = $false
    Run from an elevated PowerShell session with appropriate
    administrative rights to the target servers.
#>
Import-Module ActiveDirectory
# ============================================================
# CONFIGURATION
# ============================================================
$CSVFile = ".\Domain-DHCP-Audit.csv"
# ------------------------------------------------------------
# SAFETY SETTINGS
# ------------------------------------------------------------
# FALSE = Active scopes are a HARD STOP.
#
# TRUE = Active scopes still stop removal, but the operator
#        may explicitly override the lock for that server.
#
$AllowActiveScopeOverride = $false
# FALSE = Do not automatically reboot servers.
# TRUE  = Windows may reboot the server during role removal.
#
# Recommended: FALSE
#
$AllowReboot = $false
# FALSE = Leave DHCP authorization in Active Directory.
# TRUE  = After successful role removal, optionally remove
#         DHCP authorization from AD.
#
# Recommended initial setting: FALSE
#
$RemoveDHCPAuthorization = $false
# ------------------------------------------------------------
# OUTPUT FILES
# ------------------------------------------------------------
$RemovalLog = ".\DHCP-Removal-Results.csv"
$ScopeBackup = ".\DHCP-Scope-Backup.csv"
$RebootList = ".\DHCP-Servers-Requiring-Reboot.csv"
# ============================================================
# HELPER FUNCTION
# ============================================================
function Get-RemoteDHCPState {
    param (
        [Parameter(Mandatory)]
        [string]$ComputerName
    )
    Invoke-Command `
        -ComputerName $ComputerName `
        -ErrorAction Stop `
        -ScriptBlock {
            # ------------------------------------------------
            # DHCP ROLE
            # ------------------------------------------------
            $Role = Get-WindowsFeature `
                -Name DHCP `
                -ErrorAction SilentlyContinue
            $RoleInstalled = (
                $Role -and
                $Role.InstallState -eq "Installed"
            )
            # ------------------------------------------------
            # DHCP SERVICE
            # ------------------------------------------------
            $Service = Get-Service `
                -Name DHCPServer `
                -ErrorAction SilentlyContinue
            $ServiceInstalled = [bool]$Service
            $ServiceStatus = if ($Service) {
                $Service.Status.ToString()
            }
            else {
                "Not Installed"
            }
            # ------------------------------------------------
            # DHCP SCOPES
            # ------------------------------------------------
            $Scopes = @()
            if ($RoleInstalled -or $ServiceInstalled) {
                try {
                    Import-Module DhcpServer `
                        -ErrorAction Stop
                    $Scopes = @(
                        Get-DhcpServerv4Scope `
                            -ErrorAction Stop |
                        Select-Object `
                            ScopeId,
                            Name,
                            State,
                            StartRange,
                            EndRange,
                            SubnetMask
                    )
                }
                catch {
                    # If DHCP is in a pending-removal state,
                    # the DHCP module may no longer be available.
                    $Scopes = @()
                }
            }
            # ------------------------------------------------
            # ACTIVE SCOPES
            # ------------------------------------------------
            $ActiveScopes = @(
                $Scopes |
                    Where-Object {
                        $_.State -eq "Active"
                    }
            )
            # ------------------------------------------------
            # RETURN STATE
            # ------------------------------------------------
            [PSCustomObject]@{
                ComputerName = $env:COMPUTERNAME
                RoleInstalled = $RoleInstalled
                ServiceInstalled = $ServiceInstalled
                ServiceStatus = $ServiceStatus
                ScopeCount = @($Scopes).Count
                ActiveScopeCount = @($ActiveScopes).Count
                Scopes = $Scopes
                ActiveScopes = $ActiveScopes
            }
        }
}
# ============================================================
# VERIFY INPUT CSV
# ============================================================
if (-not (Test-Path $CSVFile)) {
    Write-Host ""
    Write-Host "ERROR: CSV file not found:" `
        -ForegroundColor Red
    Write-Host $CSVFile `
        -ForegroundColor Yellow
    Write-Host ""
    exit 1
}
# ============================================================
# IMPORT CSV
# ============================================================
Write-Host ""
Write-Host "Reading DHCP audit CSV..." `
    -ForegroundColor Cyan
$CSV = Import-Csv $CSVFile
if (-not $CSV) {
    Write-Host ""
    Write-Host "CSV contains no records." `
        -ForegroundColor Yellow
    exit 0
}
# ============================================================
# FIND DHCP SERVERS FROM CSV
# ============================================================
$TargetServers = @(
    $CSV |
        Where-Object {
            $_.DHCPRole -eq "Installed" -or
            $_.DHCPService -eq "Installed"
        } |
        Sort-Object Server
)
if (-not $TargetServers) {
    Write-Host ""
    Write-Host "No DHCP servers found in the CSV." `
        -ForegroundColor Green
    exit 0
}
# ============================================================
# DISPLAY TARGET SERVERS
# ============================================================
Write-Host ""
Write-Host "============================================================" `
    -ForegroundColor Yellow
Write-Host "             DHCP REMOVAL CANDIDATES" `
    -ForegroundColor Yellow
Write-Host "============================================================" `
    -ForegroundColor Yellow
Write-Host ""
$TargetServers |
    Format-Table `
        Server,
        DHCPRole,
        DHCPService,
        ServiceStatus,
        Authorized,
        ScopeCount `
        -AutoSize
Write-Host ""
Write-Host "IMPORTANT:" `
    -ForegroundColor Yellow
Write-Host ""
Write-Host "The CSV is only being used to identify candidate servers."
Write-Host "The CURRENT DHCP configuration will be checked again"
Write-Host "immediately before any role is removed."
Write-Host ""
# ============================================================
# INITIAL SAFETY CONFIRMATION
# ============================================================
$Confirmation = Read-Host `
    "Type REMOVE-DHCP to begin checking servers"
if ($Confirmation -cne "REMOVE-DHCP") {
    Write-Host ""
    Write-Host "Operation cancelled. No changes were made." `
        -ForegroundColor Green
    exit 0
}
# ============================================================
# PROCESS EACH SERVER
# ============================================================
$Results = foreach ($Target in $TargetServers) {
    $Server = $Target.Server
    Write-Host ""
    Write-Host "============================================================" `
        -ForegroundColor Cyan
    Write-Host "Checking: $Server" `
        -ForegroundColor Cyan
    Write-Host "============================================================" `
        -ForegroundColor Cyan
    # ========================================================
    # CONNECTIVITY CHECK
    # ========================================================
    if (-not (
        Test-Connection `
            -ComputerName $Server `
            -Count 1 `
            -Quiet `
            -ErrorAction SilentlyContinue
    )) {
        Write-Host ""
        Write-Host "LOCKED: Server is unreachable." `
            -ForegroundColor Red
        [PSCustomObject]@{
            Server = $Server
            Action = "LOCKED"
            Result = "Unreachable"
            RoleBefore = $Target.DHCPRole
            ServiceBefore = $Target.DHCPService
            ServiceStatus = "Unknown"
            ScopeCount = "Unknown"
            ActiveScopes = "Unknown"
            RoleAfter = "Unknown"
            ServiceAfter = "Unknown"
            RebootRequired = "Unknown"
            Authorization = $Target.Authorized
            Notes = "Server did not respond to ping"
        }
        continue
    }
    try {
        # ====================================================
        # FRESH DHCP STATE CHECK
        # ====================================================
        Write-Host ""
        Write-Host "Performing fresh DHCP configuration check..." `
            -ForegroundColor Gray
        $DHCP = Get-RemoteDHCPState `
            -ComputerName $Server
        # ====================================================
        # DHCP ALREADY REMOVED
        # ====================================================
        if (-not $DHCP.RoleInstalled) {
            Write-Host ""
            Write-Host "DHCP Windows Feature is already removed." `
                -ForegroundColor Green
            # The service may still exist because the machine
            # has not yet been rebooted.
            $ExistingServiceState = if ($DHCP.ServiceInstalled) {
                "Pending Reboot"
            }
            else {
                "Not Installed"
            }
            [PSCustomObject]@{
                Server = $Server
                Action = "None"
                Result = if ($DHCP.ServiceInstalled) {
                    "Already Removed - Reboot May Be Required"
                }
                else {
                    "Already Removed"
                }
                RoleBefore = "Not Installed"
                ServiceBefore = $ExistingServiceState
                ServiceStatus = $DHCP.ServiceStatus
                ScopeCount = $DHCP.ScopeCount
                ActiveScopes = $DHCP.ActiveScopeCount
                RoleAfter = "Not Installed"
                ServiceAfter = $ExistingServiceState
                RebootRequired = if ($DHCP.ServiceInstalled) {
                    "Yes"
                }
                else {
                    "No"
                }
                Authorization = $Target.Authorized
                Notes = if ($DHCP.ServiceInstalled) {
                    "DHCP role removed; DHCPServer service still present pending reboot"
                }
                else {
                    ""
                }
            }
            continue
        }
        # ====================================================
        # DISPLAY CURRENT DHCP STATE
        # ====================================================
        Write-Host ""
        Write-Host "Current DHCP state:" `
            -ForegroundColor White
        Write-Host "  Role installed:  $($DHCP.RoleInstalled)"
        Write-Host "  Service present: $($DHCP.ServiceInstalled)"
        Write-Host "  Service status:  $($DHCP.ServiceStatus)"
        Write-Host "  Total scopes:    $($DHCP.ScopeCount)"
        Write-Host "  ACTIVE scopes:   $($DHCP.ActiveScopeCount)"
        # ====================================================
        # SAVE SCOPE INFORMATION
        # ====================================================
        if ($DHCP.ScopeCount -gt 0) {
            $ScopeBackupRows = foreach ($Scope in $DHCP.Scopes) {
                [PSCustomObject]@{
                    Server = $Server
                    ScopeId = $Scope.ScopeId
                    Name = $Scope.Name
                    State = $Scope.State
                    StartRange = $Scope.StartRange
                    EndRange = $Scope.EndRange
                    SubnetMask = $Scope.SubnetMask
                }
            }
            $ScopeBackupRows |
                Export-Csv `
                    -Path $ScopeBackup `
                    -NoTypeInformation `
                    -Append `
                    -Encoding UTF8
        }
        # ====================================================
        # ACTIVE-SCOPE SAFETY LOCK
        # ====================================================
        if ($DHCP.ActiveScopeCount -gt 0) {
            Write-Host ""
            Write-Host "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" `
                -ForegroundColor Red
            Write-Host "               ACTIVE SCOPE SAFETY LOCK" `
                -ForegroundColor Red
            Write-Host "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" `
                -ForegroundColor Red
            Write-Host ""
            Write-Host "$Server has $($DHCP.ActiveScopeCount) ACTIVE DHCP scope(s)." `
                -ForegroundColor Red
            Write-Host ""
            Write-Host "ACTIVE SCOPES:" `
                -ForegroundColor Yellow
            Write-Host ""
            $DHCP.ActiveScopes |
                Format-Table `
                    ScopeId,
                    Name,
                    State,
                    StartRange,
                    EndRange `
                    -AutoSize
            Write-Host ""
            Write-Host "DHCP ROLE REMOVAL IS BLOCKED." `
                -ForegroundColor Red
            # ------------------------------------------------
            # OPTIONAL ACTIVE-SCOPE OVERRIDE
            # ------------------------------------------------
            if ($AllowActiveScopeOverride) {
                Write-Host ""
                Write-Host "Active-scope override is enabled." `
                    -ForegroundColor Yellow
                Write-Host ""
                Write-Host "WARNING: Removing DHCP with active scopes may" `
                    -ForegroundColor Red
                Write-Host "cause DHCP service outages." `
                    -ForegroundColor Red
                Write-Host ""
                $Override = Read-Host `
                    "Type REMOVE-ACTIVE-SCOPES-$Server to override"
                if ($Override -cne "REMOVE-ACTIVE-SCOPES-$Server") {
                    Write-Host ""
                    Write-Host "Server remains LOCKED." `
                        -ForegroundColor Yellow
                    [PSCustomObject]@{
                        Server = $Server
                        Action = "LOCKED"
                        Result = "Active Scopes"
                        RoleBefore = "Installed"
                        ServiceBefore = "Installed"
                        ServiceStatus = $DHCP.ServiceStatus
                        ScopeCount = $DHCP.ScopeCount
                        ActiveScopes = $DHCP.ActiveScopeCount
                        RoleAfter = "Installed"
                        ServiceAfter = $DHCP.ServiceStatus
                        RebootRequired = "No"
                        Authorization = $Target.Authorized
                        Notes = "Active scope safety lock"
                    }
                    continue
                }
                Write-Host ""
                Write-Host "ACTIVE SCOPE OVERRIDE ACCEPTED." `
                    -ForegroundColor Red
            }
            else {
                [PSCustomObject]@{
                    Server = $Server
                    Action = "LOCKED"
                    Result = "Active Scopes"
                    RoleBefore = "Installed"
                    ServiceBefore = "Installed"
                    ServiceStatus = $DHCP.ServiceStatus
                    ScopeCount = $DHCP.ScopeCount
                    ActiveScopes = $DHCP.ActiveScopeCount
                    RoleAfter = "Installed"
                    ServiceAfter = $DHCP.ServiceStatus
                    RebootRequired = "No"
                    Authorization = $Target.Authorized
                    Notes = "Active scope safety lock - removal blocked"
                }
                continue
            }
        }
        # ====================================================
        # PER-SERVER CONFIRMATION
        # ====================================================
        Write-Host ""
        if ($DHCP.ActiveScopeCount -eq 0) {
            Write-Host "No ACTIVE DHCP scopes detected." `
                -ForegroundColor Green
        }
        Write-Host ""
        Write-Host "READY TO REMOVE DHCP FROM: $Server" `
            -ForegroundColor Yellow
        Write-Host ""
        Write-Host "Total scopes:  $($DHCP.ScopeCount)"
        Write-Host "Active scopes: $($DHCP.ActiveScopeCount)"
        Write-Host ""
        $ServerConfirmation = Read-Host `
            "Type REMOVE-$Server to remove DHCP"
        if ($ServerConfirmation -cne "REMOVE-$Server") {
            Write-Host ""
            Write-Host "Skipped by operator." `
                -ForegroundColor Yellow
            [PSCustomObject]@{
                Server = $Server
                Action = "Skipped"
                Result = "Operator Cancelled"
                RoleBefore = "Installed"
                ServiceBefore = "Installed"
                ServiceStatus = $DHCP.ServiceStatus
                ScopeCount = $DHCP.ScopeCount
                ActiveScopes = $DHCP.ActiveScopeCount
                RoleAfter = "Installed"
                ServiceAfter = $DHCP.ServiceStatus
                RebootRequired = "No"
                Authorization = $Target.Authorized
                Notes = ""
            }
            continue
        }
        # ====================================================
        # REMOVE DHCP SERVER ROLE
        # ====================================================
        Write-Host ""
        Write-Host "Removing DHCP Server role from $Server..." `
            -ForegroundColor Yellow
        $InstallResult = Invoke-Command `
            -ComputerName $Server `
            -ErrorAction Stop `
            -ScriptBlock {
                Uninstall-WindowsFeature `
                    -Name DHCP `
                    -IncludeManagementTools `
                    -Restart:$using:AllowReboot
            }
        # ====================================================
        # DISPLAY WINDOWS REMOVAL RESULT
        # ====================================================
        Write-Host ""
        Write-Host "Windows Feature removal result:" `
            -ForegroundColor Gray
        Write-Host "  Success:       $($InstallResult.Success)"
        Write-Host "  RestartNeeded: $($InstallResult.RestartNeeded)"
        Write-Host "  ExitCode:      $($InstallResult.ExitCode)"
        Write-Host ""
        # ====================================================
        # VERIFY REMOVAL
        # ====================================================
        Write-Host "Verifying DHCP role removal..." `
            -ForegroundColor Yellow
        Start-Sleep -Seconds 5
        $After = Get-RemoteDHCPState `
            -ComputerName $Server
        # ----------------------------------------------------
        # IMPORTANT:
        #
        # Get-WindowsFeature DHCP is authoritative here.
        #
        # The DHCPServer service may remain visible after
        # successful role removal until Windows is rebooted.
        #
        # Therefore:
        #
        # Role not installed = successful removal.
        #
        # We DO NOT require the service object to disappear
        # before declaring success.
        # ----------------------------------------------------
        if (-not $After.RoleInstalled) {
            if ($InstallResult.RestartNeeded -eq "Yes") {
                Write-Host ""
                Write-Host "SUCCESS: DHCP role removed from $Server." `
                    -ForegroundColor Green
                Write-Host "REBOOT REQUIRED to complete removal." `
                    -ForegroundColor Yellow
                $Result = "Successfully Removed - Reboot Required"
                $RebootRequired = "Yes"
            }
            else {
                Write-Host ""
                Write-Host "SUCCESS: DHCP role removed from $Server." `
                    -ForegroundColor Green
                $Result = "Successfully Removed"
                $RebootRequired = "No"
            }
        }
        else {
            Write-Host ""
            Write-Host "WARNING: DHCP Windows Feature still reports Installed." `
                -ForegroundColor Red
            $Result = "Removal Failed"
            $RebootRequired = if (
                $InstallResult.RestartNeeded -eq "Yes"
            ) {
                "Yes"
            }
            else {
                "No"
            }
        }
        # ====================================================
        # DETERMINE SERVICE DISPLAY STATE
        # ====================================================
        if ($After.ServiceInstalled) {
            if (
                -not $After.RoleInstalled -and
                $InstallResult.RestartNeeded -eq "Yes"
            ) {
                $ServiceAfter = "Pending Reboot"
            }
            else {
                $ServiceAfter = $After.ServiceStatus
            }
        }
        else {
            $ServiceAfter = "Not Installed"
        }
        # ====================================================
        # BUILD RESULT OBJECT
        # ====================================================
        [PSCustomObject]@{
            Server = $Server
            Action = "Remove DHCP"
            Result = $Result
            RoleBefore = "Installed"
            ServiceBefore = if ($DHCP.ServiceInstalled) {
                "Installed"
            }
            else {
                "Not Installed"
            }
            ServiceStatus = $DHCP.ServiceStatus
            ScopeCount = $DHCP.ScopeCount
            ActiveScopes = $DHCP.ActiveScopeCount
            RoleAfter = if ($After.RoleInstalled) {
                "Installed"
            }
            else {
                "Not Installed"
            }
            ServiceAfter = $ServiceAfter
            RebootRequired = $RebootRequired
            Authorization = $Target.Authorized
            Notes = if (
                $Result -eq "Successfully Removed - Reboot Required"
            ) {
                "DHCP role removed successfully - server reboot required"
            }
            elseif ($Result -eq "Removal Failed") {
                "DHCP Windows Feature still reports Installed"
            }
            else {
                ""
            }
        }
    }
    catch {
        Write-Host ""
        Write-Host "ERROR processing $Server" `
            -ForegroundColor Red
        Write-Host $_.Exception.Message `
            -ForegroundColor Red
        [PSCustomObject]@{
            Server = $Server
            Action = "Error"
            Result = "Error"
            RoleBefore = $Target.DHCPRole
            ServiceBefore = $Target.DHCPService
            ServiceStatus = "Unknown"
            ScopeCount = "Unknown"
            ActiveScopes = "Unknown"
            RoleAfter = "Unknown"
            ServiceAfter = "Unknown"
            RebootRequired = "Unknown"
            Authorization = $Target.Authorized
            Notes = $_.Exception.Message
        }
    }
}
# ============================================================
# FINAL RESULTS
# ============================================================
Write-Host ""
Write-Host "============================================================" `
    -ForegroundColor Green
Write-Host "                    FINAL RESULTS" `
    -ForegroundColor Green
Write-Host "============================================================" `
    -ForegroundColor Green
Write-Host ""
$Results |
    Format-Table `
        Server,
        Action,
        Result,
        ActiveScopes,
        RoleAfter,
        ServiceAfter,
        RebootRequired,
        Notes `
        -Wrap `
        -AutoSize
# ============================================================
# EXPORT COMPLETE RESULTS
# ============================================================
$Results |
    Export-Csv `
        -Path $RemovalLog `
        -NoTypeInformation `
        -Encoding UTF8
# ============================================================
# CREATE REBOOT LIST
# ============================================================
$ServersRequiringReboot = @(
    $Results |
        Where-Object {
            $_.RebootRequired -eq "Yes"
        }
)
if ($ServersRequiringReboot.Count -gt 0) {
    $ServersRequiringReboot |
        Select-Object `
            Server,
            Result,
            RoleAfter,
            ServiceAfter,
            Notes |
        Export-Csv `
            -Path $RebootList `
            -NoTypeInformation `
            -Encoding UTF8
    Write-Host ""
    Write-Host "============================================================" `
        -ForegroundColor Yellow
    Write-Host "             SERVERS REQUIRING REBOOT" `
        -ForegroundColor Yellow
    Write-Host "============================================================" `
        -ForegroundColor Yellow
    Write-Host ""
    $ServersRequiringReboot |
        Format-Table `
            Server,
            Result,
            RoleAfter,
            ServiceAfter `
            -AutoSize
}
# ============================================================
# OPTIONAL DHCP AUTHORIZATION CLEANUP
# ============================================================
if ($RemoveDHCPAuthorization) {
    Write-Host ""
    Write-Host "============================================================" `
        -ForegroundColor Red
    Write-Host "         DHCP AUTHORIZATION CLEANUP ENABLED" `
        -ForegroundColor Red
    Write-Host "============================================================" `
        -ForegroundColor Red
    Write-Host ""
    $AuthConfirmation = Read-Host `
        "Type REMOVE-DHCP-AUTH to continue"
    if ($AuthConfirmation -cne "REMOVE-DHCP-AUTH") {
        Write-Host ""
        Write-Host "AD authorization cleanup cancelled." `
            -ForegroundColor Yellow
    }
    else {
        try {
            Import-Module DhcpServer `
                -ErrorAction Stop
            $AuthorizedDHCP = Get-DhcpServerInDC `
                -ErrorAction Stop
            foreach ($Target in $TargetServers) {
                $Server = $Target.Server
                # --------------------------------------------
                # Only remove authorization for servers whose
                # DHCP role was successfully removed.
                #
                # This now includes:
                #
                # Successfully Removed
                #
                # AND
                #
                # Successfully Removed - Reboot Required
                # --------------------------------------------
                $RemovalResult = $Results |
                    Where-Object {
                        $_.Server -eq $Server
                    }
                if (
                    $RemovalResult.Result -notlike
                    "Successfully Removed*"
                ) {
                    continue
                }
                # --------------------------------------------
                # Find DHCP authorization
                # --------------------------------------------
                $Authorized = $AuthorizedDHCP |
                    Where-Object {
                        $_.DnsName -ieq $Server -or
                        (
                            $_.DnsName.Split(".")[0] -ieq
                            $Server.Split(".")[0]
                        )
                    }
                if ($Authorized) {
                    Write-Host ""
                    Write-Host "Removing AD DHCP authorization for $Server..." `
                        -ForegroundColor Yellow
                    try {
                        Remove-DhcpServerInDC `
                            -DnsName $Authorized.DnsName `
                            -IPAddress $Authorized.IPAddress `
                            -ErrorAction Stop
                        Write-Host "Authorization removed." `
                            -ForegroundColor Green
                    }
                    catch {
                        Write-Host ""
                        Write-Host "Could not remove authorization:" `
                            -ForegroundColor Red
                        Write-Host $_.Exception.Message `
                            -ForegroundColor Red
                    }
                }
                else {
                    Write-Host ""
                    Write-Host "$Server is not currently authorized in AD." `
                        -ForegroundColor Gray
                }
            }
        }
        catch {
            Write-Host ""
            Write-Host "Unable to query DHCP authorization in AD." `
                -ForegroundColor Red
            Write-Host $_.Exception.Message `
                -ForegroundColor Red
        }
    }
}
# ============================================================
# FINAL SUMMARY
# ============================================================
$Successful = @(
    $Results |
        Where-Object {
            $_.Result -like "Successfully Removed*"
        }
).Count
$Failed = @(
    $Results |
        Where-Object {
            $_.Result -eq "Removal Failed" -or
            $_.Result -eq "Error"
        }
).Count
$Locked = @(
    $Results |
        Where-Object {
            $_.Action -eq "LOCKED"
        }
).Count
$RebootCount = @(
    $Results |
        Where-Object {
            $_.RebootRequired -eq "Yes"
        }
).Count
Write-Host ""
Write-Host "============================================================" `
    -ForegroundColor Green
Write-Host "                    SUMMARY" `
    -ForegroundColor Green
Write-Host "============================================================" `
    -ForegroundColor Green
Write-Host ""
Write-Host "Successfully removed : $Successful" `
    -ForegroundColor Green
Write-Host "Removal failures     : $Failed" `
    -ForegroundColor $(if ($Failed -gt 0) { "Red" } else { "Green" })
Write-Host "Safety locked        : $Locked" `
    -ForegroundColor $(if ($Locked -gt 0) { "Yellow" } else { "Green" })
Write-Host "Reboot required      : $RebootCount" `
    -ForegroundColor $(if ($RebootCount -gt 0) { "Yellow" } else { "Green" })
Write-Host ""
Write-Host "Removal results:" `
    -ForegroundColor Cyan
Write-Host $RemovalLog
if (Test-Path $ScopeBackup) {
    Write-Host ""
    Write-Host "DHCP scope backup:" `
        -ForegroundColor Cyan
    Write-Host $ScopeBackup
}
if ($RebootCount -gt 0) {
    Write-Host ""
    Write-Host "Servers requiring reboot:" `
        -ForegroundColor Cyan
    Write-Host $RebootList
}
Write-Host ""
Write-Host "============================================================" `
    -ForegroundColor Green
Write-Host "DHCP removal operation complete." `
    -ForegroundColor Green
Write-Host "============================================================" `
    -ForegroundColor Green
Write-Host ""
